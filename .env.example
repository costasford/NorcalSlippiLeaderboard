# Copy to .env (which is gitignored) and fill in real values.
# Only needed for running tag-request-api - the cron job needs no env vars
# beyond the optional DATA_DIR override (see README).

# Discord webhook URL that tag/removal requests get posted to.
# Create one via a channel's Settings -> Integrations -> Webhooks.
# Treat this like a password - anyone with it can post into that channel.
DISCORD_WEBHOOK_URL=

# Random secret used to sign the Approve/Reject links attached to each
# Discord message. Generate one with `openssl rand -hex 32`. Treat this
# like a password - anyone with it can forge an approval link. Leave unset
# to disable the buttons (requests still post to Discord, but approving a
# tag change goes back to editing cron/players.json by hand).
APPROVAL_SECRET=

# Publicly reachable base URL for this service (no trailing slash) - used
# to build the Approve/Reject links, e.g. https://68.183.26.83.sslip.io.
# Required alongside APPROVAL_SECRET for the buttons to appear.
PUBLIC_BASE_URL=
