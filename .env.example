# Copy to .env (which is gitignored) and fill in real values.
# Only needed for running tag-request-api - the cron job needs no env vars
# beyond the optional DATA_DIR override (see README).

# Discord webhook URL that tag/removal requests get posted to.
# Create one via a channel's Settings -> Integrations -> Webhooks.
# Treat this like a password - anyone with it can post into that channel.
DISCORD_WEBHOOK_URL=
