# Copy to .env (which is gitignored) and fill in real values.
# Only needed for running tag-request-api - the cron job needs no env vars
# beyond the optional DATA_DIR override (see README).

# Bot token used to post tag/removal requests into Discord. Must belong to
# a bot invited to the server with View Channel + Send Messages on the
# target channel. Plain incoming webhooks silently drop the Approve/Reject
# buttons (Discord accepts the request, buttons just never render), so this
# has to be a real bot token, not a webhook URL. Treat this like a password.
DISCORD_BOT_TOKEN=

# ID of the Discord channel to post tag/removal requests into. Right-click
# the channel in Discord (with Developer Mode enabled) and "Copy Channel ID".
DISCORD_CHANNEL_ID=

# Optional: ID of a public channel to announce approved roster changes into
# (e.g. "CRSH#514 was added to the Melee leaderboard."). Leave unset to skip
# announcements - approvals still work, they just stay mod-only.
DISCORD_ANNOUNCE_CHANNEL_ID=

# Random secret used to sign the Approve/Reject links attached to each
# Discord message. Generate one with `openssl rand -hex 32`. Treat this
# like a password - anyone with it can forge an approval link. Leave unset
# to disable the buttons (requests still post to Discord, but approving a
# tag change goes back to editing cron/players.json by hand).
APPROVAL_SECRET=

# Publicly reachable base URL for this service (no trailing slash) - used
# to build the Approve/Reject links, e.g. https://68.183.26.83.sslip.io.
# Required alongside APPROVAL_SECRET for the buttons to appear.
PUBLIC_BASE_URL=
